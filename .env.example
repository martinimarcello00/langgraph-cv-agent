# OpenAI API Configuration
OPENAI_API_KEY=sk-...
OPENAI_ADMIN_API_KEY=sk-... # Optional: For usage tracking if different from main key
DAILY_TOKEN_LIMIT=50000     # Optional: Daily token usage limit

# Mailgun Configuration (Optional - for sending emails)
MAILGUN_API_KEY=key-...
MAILGUN_URL=https://api.mailgun.net/v3/your-domain.com
MAILGUN_SENDER=postmaster@your-domain.com
